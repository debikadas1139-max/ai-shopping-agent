# Copy this file to ".env" (same folder) and fill in your values.
# NEVER commit the real .env file.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model that decides which tools to call (must support tool calling).
GROQ_MODEL=openai/gpt-oss-120b

# Model that reads uploaded product photos (must accept image input).
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# SQLite file. A relative path is resolved from the backend/ folder.
DATABASE_URL=sqlite:///./store.db

# Address of the React dev server (comma-separate to allow several).
FRONTEND_ORIGIN=http://localhost:5173
